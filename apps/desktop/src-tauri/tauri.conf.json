{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ENJOYTRUCKERS",
  "version": "0.1.30",
  "identifier": "jp.truckers.portal.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ENJOYTRUCKERS",
        "width": 800,
        "height": 480,
        "minWidth": 640,
        "minHeight": 384,
        "resizable": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "languages": [
          "Japanese",
          "English",
          "SimpChinese",
          "TradChinese",
          "Korean"
        ],
        "displayLanguageSelector": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1QkM3MUQzMjg4RkVFMzUKUldRMTdvOG8wM0c4aGZpVm9qQXArZ05lbThERFFUQlBlN3lSczdLbzY4K29LanBPSG1IN01XRG0K",
      "endpoints": [
        "https://portal.truckers.jp/api/desktop/updater"
      ]
    }
  }
}
